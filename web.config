<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
		<!-- Configuración de iisnode -->
		<iisnode nodeProcessCommandLine="C:\Program Files\nodejs\node.exe" />
		<!-- <iisnode nodeProcessCommandLine="C:\Program Files\nodejs\node.exe" loggingEnabled="true" devErrorsEnabled="true" /> -->
		
		<!-- Configuración de handlers -->
        <handlers>
            <add name="iisnode" path="server.js" verb="*" modules="iisnode" resourceType="File" />
        </handlers>
		
		<!-- Configuración de reescritura de URL -->
		<rewrite>
			<rules>
				<rule name="reqToServerjs">
					<match url=".*" />
					<action type="Rewrite" url="server.js" />				
				</rule>
			</rules>
		</rewrite>
    </system.webServer>
</configuration>
