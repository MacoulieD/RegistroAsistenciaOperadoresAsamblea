# Copiar este archivo como ".env.test" (junto a este mismo, en src/) y
# completar con los datos del ambiente de pruebas. NO se sube al deploy de
# producción: si no existe, el servidor sigue usando src/.env como siempre.

DB_SERVER=tu_servidor_sql_de_pruebas
DB_PORT=1433
DB_NAME=ASAMBLEA_TEST
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

SESSION_SECRET=cualquier_valor_para_pruebas
RECAPTCHA_SECRET=

# Puerto distinto para poder correrlo junto a una instancia de producción
# en la misma máquina sin chocar.
PORT=3004
